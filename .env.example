# ============================================================
# LLM 多模型配置
# ============================================================
# 默认模型（通用任务）
LLM_DEFAULT_MODEL=deepseek-chat
LLM_DEFAULT_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_API_KEY=your_deepseek_api_key_here

# 推理模型（复杂推理任务，可选）
LLM_REASONER_MODEL=deepseek-reasoner
LLM_REASONER_BASE_URL=https://api.deepseek.com
LLM_REASONER_API_KEY=your_deepseek_api_key_here

# 降级链（主模型挂了依次切换，可选）
# LLM_FALLBACK_CHAIN=default,judge

# Query 改写小模型（可选，默认用 default）
# REWRITE_MODEL=default

# ============================================================
# Embedding 向量化（阿里云 DashScope，必填！RAG 核心）
# ============================================================
# 申请地址：https://dashscope.aliyun.com → 模型服务 → 获取 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# --- Embedding 增强（可选；默认全部关闭，保持与论文基线一致的口径）---
# 调用模式：compatible（默认，OpenAI 兼容端点）| native（DashScope 原生端点）
# text_type / instruct / 稀疏向量这三项能力「仅支持通过 DashScope SDK 及 API 启用」，
# 兼容端点拿不到，所以必须切到 native 才生效。
#EMBEDDING_API_MODE=native
# 任务指令（官方称通常带来 1%~5% 效果提升，建议用英文撰写）；留空则不下发该参数
#EMBEDDING_INSTRUCT_QUERY=Given a fitness question, retrieve knowledge chunks that answer it
#EMBEDDING_INSTRUCT_DOCUMENT=
# 输出类型：dense（默认）| sparse | dense&sparse
#EMBEDDING_OUTPUT_TYPE=dense&sparse
# 稀疏词法检索路（第三路，进 src/rag/fusion.py 的同一套 RRF）：off（默认）| on
# 用于替代 pg_trgm——中文三元组匹配噪音大，稀疏向量是类 SPLADE 的学习型词法检索。
# 依赖 EMBEDDING_API_MODE=native 且 EMBEDDING_OUTPUT_TYPE 含 sparse；
# 依赖不满足时自动按 off 处理，检索退回向量+关键词双路，绝不中断。
#SPARSE_RETRIEVAL=off
# ⚠️ 切到 native 会改变向量取值（两种模式的向量不在同一语义空间），
#    必须全量重摄入后再重跑评测，不可与旧向量混用：
#      python -m src.rag.knowledge_ingestion        # 不要加 --incremental

# ============================================================
# LLM-as-Judge 异构裁判（评测用，可选）
# ============================================================
# 与生成模型不同厂商，消除 self-preference bias（自偏好偏差）
# 复用 DashScope key 即可
LLM_JUDGE_MODEL=qwen-plus
LLM_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_JUDGE_API_KEY=your_dashscope_api_key_here

# RAGAS 评测裁判（ragas_eval.py 读取，可选，建议与 LLM_JUDGE 保持一致）
EVAL_LLM_MODEL=qwen-plus
EVAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_LLM_API_KEY=your_dashscope_api_key_here

# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# ============================================================
# PostgreSQL + pgvector
# ============================================================
# 注意：端口是宿主机映射端口 5433（见 docker-compose.yml 5433:5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ai_fitness
POSTGRES_PASSWORD=fitness123
POSTGRES_DB=fitness_assistant

# ============================================================
# Neo4j 图数据库
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fitness123

# ============================================================
# Redis 缓存
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6380

# ============================================================
# MinIO 对象存储
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== HTTP 安全加固（可选，不设则保持本地演示默认行为）=====
# /api/* 业务接口 Bearer 令牌；为空=不启用认证
API_AUTH_TOKEN=
# /admin/* 管理端点专用令牌（X-Admin-Token）；与 API_AUTH_TOKEN 都不设时管理端点 403 拒绝
ADMIN_TOKEN=
# 每客户端 IP 每分钟请求上限（/health/* 不受限）
RATE_LIMIT_PER_MINUTE=60
# CORS 白名单（逗号分隔），默认仅本机前端来源
#CORS_ALLOW_ORIGINS=http://localhost:8503,http://127.0.0.1:8503,http://localhost:3000
# 人工审核存储后端：sqlite（默认，重启不丢）| memory（离线测试）
#HITL_STORE_BACKEND=sqlite
# 检查点后端：sqlite（默认）| postgres（需 langgraph-checkpoint-postgres 与 PG）
#GRAPH_CHECKPOINT_BACKEND=sqlite

# ===== 文档解析后端（文件上传 RAG 的第一跳，可选）=====
# pdfplumber（默认，零额外依赖）| mineru（本地 MinerU CLI，失败自动回落 pdfplumber）
# MinerU 覆盖 pdfplumber 的三个盲区：扫描件（无文本层）、无框线表格、跨页表格
# ——体检报告恰好是三者叠加，也是本项目文件上传的主场景。
# 安装（装在项目外的独立环境，不要装进本仓库 .venv，否则会引入 torch 等重依赖）：
#   pip install -U "mineru[all]"
# 官方门槛：Python 3.10-3.13、最低 16GB RAM（推荐 32GB+）、约 20GB 磁盘。
# 接入方式是 CLI 子进程而非常驻服务：用时才起、用完即释放，不与四个容器争内存。
# 全程本地执行，用户上传的体检报告不会发往任何外部服务（官方另有云端
# mineru-open-sdk，依赖极轻，但需上传文档，与本项目隐私口径冲突，故不接）。
#DOC_PARSER_BACKEND=pdfplumber
#MINERU_CLI=mineru
# pipeline=传统多模型流水线，纯 CPU 可跑（约 2-3 秒/页）；vlm-*=需 GPU，快一个量级
#MINERU_BACKEND=pipeline
# 单次解析超时（秒）。纯 CPU 下有模型冷启动开销，体检报告通常 3-10 页
#MINERU_TIMEOUT=300
# 模型源：国内用 modelscope 避免 HuggingFace 超时；留空则用 MinerU 自身默认
#MINERU_MODEL_SOURCE=modelscope
