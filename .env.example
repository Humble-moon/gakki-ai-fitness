# ============================================================
# LLM 多模型配置
# ============================================================
# 默认模型（通用任务）
LLM_DEFAULT_MODEL=deepseek-chat
LLM_DEFAULT_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_API_KEY=your_deepseek_api_key_here

# 推理模型（复杂推理任务，可选）
LLM_REASONER_MODEL=deepseek-reasoner
LLM_REASONER_BASE_URL=https://api.deepseek.com
LLM_REASONER_API_KEY=your_deepseek_api_key_here

# 降级链（主模型挂了依次切换，可选）
# LLM_FALLBACK_CHAIN=default,judge

# Query 改写小模型（可选，默认用 default）
# REWRITE_MODEL=default

# ============================================================
# Embedding 向量化（阿里云 DashScope，必填！RAG 核心）
# ============================================================
# 申请地址：https://dashscope.aliyun.com → 模型服务 → 获取 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ============================================================
# LLM-as-Judge 异构裁判（评测用，可选）
# ============================================================
# 与生成模型不同厂商，消除 self-preference bias（自偏好偏差）
# 复用 DashScope key 即可
LLM_JUDGE_MODEL=qwen-plus
LLM_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_JUDGE_API_KEY=your_dashscope_api_key_here

# RAGAS 评测裁判（ragas_eval.py 读取，可选，建议与 LLM_JUDGE 保持一致）
EVAL_LLM_MODEL=qwen-plus
EVAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_LLM_API_KEY=your_dashscope_api_key_here

# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# ============================================================
# PostgreSQL + pgvector
# ============================================================
# 注意：端口是宿主机映射端口 5433（见 docker-compose.yml 5433:5432）
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ai_fitness
POSTGRES_PASSWORD=fitness123
POSTGRES_DB=fitness_assistant

# ============================================================
# Neo4j 图数据库
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fitness123

# ============================================================
# Redis 缓存
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6380

# ============================================================
# MinIO 对象存储
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== HTTP 安全加固（可选，不设则保持本地演示默认行为）=====
# /api/* 业务接口 Bearer 令牌；为空=不启用认证
API_AUTH_TOKEN=
# /admin/* 管理端点专用令牌（X-Admin-Token）；与 API_AUTH_TOKEN 都不设时管理端点 403 拒绝
ADMIN_TOKEN=
# 每客户端 IP 每分钟请求上限（/health/* 不受限）
RATE_LIMIT_PER_MINUTE=60
# CORS 白名单（逗号分隔），默认仅本机前端来源
#CORS_ALLOW_ORIGINS=http://localhost:8503,http://127.0.0.1:8503,http://localhost:3000
# 人工审核存储后端：sqlite（默认，重启不丢）| memory（离线测试）
#HITL_STORE_BACKEND=sqlite
# 检查点后端：sqlite（默认）| postgres（需 langgraph-checkpoint-postgres 与 PG）
#GRAPH_CHECKPOINT_BACKEND=sqlite
